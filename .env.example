APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ADMIN_PASSWORD=

# 额度预警通知（飞书）
# 设置数据存在独立的 SQLite 文件里，外部 newapi 库保持只读
ALERT_DB_DATABASE=
# 检查频率（cron 表达式），需要服务器上有 * * * * * php artisan schedule:run
ALERT_CHECK_CRON="*/30 * * * *"
# 余额持续低于阈值时的复发提醒间隔（小时）
ALERT_REMIND_HOURS=24
# 设置页表单里的默认预警金额（美元）
ALERT_DEFAULT_THRESHOLD=5

# 自动恢复 NewAPI 渠道（仅 auto_ban=1 且 status=3），通过管理 API 启用
# 以下为首次保存前的默认值；管理员 /admin/channel-recovery 保存后以页面设置为准
CHANNEL_RECOVERY_ENABLED=false
CHANNEL_RECOVERY_CRON="*/5 * * * *"
CHANNEL_RECOVERY_HTTP_TIMEOUT=30
# 必须与 DB_* 指向同一 NewAPI 实例；填站点根地址，不含 /api/channel 或 /v1
# 不要填本项目（api-log）自己的域名：读取渠道会返回 404，自动恢复不会生效
NEW_API_BASE_URL=
# 管理员个人访问令牌，不是用于模型调用的 sk-... 令牌
NEW_API_ACCESS_TOKEN=
NEW_API_USER_ID=
